{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Déboguer FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["pneumonia.api.app:app", "--reload", "--port", "8000"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Déboguer Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "ui\\app.py", "--server.port", "8501"],
      "console": "integratedTerminal"
    }
  ]
}
